#!/bin/sh
# lsa — Linux Subsystem for Aegis. Run LoricaOS (and, one day, other Aegis
# distributions) as a lightweight Firecracker micro-VM on this Linux host.
#
# The WSL model, inverted and session-first:
#   lsa                         open a shell in the default distribution
#   lsa <cmd> [args...]         run one command in the default distribution
#   lsa -d <distro> [cmd...]    target a specific distribution
#   lsa install [<distro>]      download + register a distribution (default: loricaos)
#   lsa list | -l               list installed distributions ('*' = default)
#   lsa set-default <distro>    make <distro> the default
#   lsa unregister <distro>     remove a distribution
#   lsa cp <src> <dst>          copy a file in/out (one side is <distro>:/path)
#   lsa stop                    terminate any running micro-VM
#   lsa version | help
#
# State (override with $LSA_HOME, default ~/.lsa):
#   firecracker                 the VMM binary
#   default                     name of the default distribution
#   distros/<name>/             kernel.elf, rootfs.img, distro.conf
set -eu

LSA_VERSION=0.1.0
LSA_HOME="${LSA_HOME:-$HOME/.lsa}"
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
FC="${LSA_FIRECRACKER:-$LSA_HOME/firecracker}"
SLIRP="${LSA_SLIRP:-$LSA_HOME/slirp4netns}"        # rootless network uplink
DISTROS="$LSA_HOME/distros"

die()  { echo "lsa: $*" >&2; exit 1; }
usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# ── distribution registry: name -> release artifact URL ──────────────────────
# A distribution is a .tar.gz of { kernel.elf, rootfs.img, distro.conf }.
registry_url() {
    case "$1" in
        loricaos) echo "https://github.com/LoricaOS/lsa/releases/download/loricaos-latest/loricaos-x86_64.tar.gz" ;;
        *)        return 1 ;;
    esac
}

default_distro() {
    [ -f "$LSA_HOME/default" ] && cat "$LSA_HOME/default" || echo loricaos
}

distro_dir() { echo "$DISTROS/$1"; }

require_distro() {
    [ -d "$(distro_dir "$1")" ] || die "distribution '$1' is not installed — try: lsa install $1"
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_install() {
    name="${1:-loricaos}"
    url="$(registry_url "$name")" || die "unknown distribution '$name'"
    dir="$(distro_dir "$name")"
    mkdir -p "$dir"
    echo "[lsa] installing '$name' from $url"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    curl -fSL "$url" -o "$tmp" || die "download failed"
    tar -xzf "$tmp" -C "$dir" || die "extract failed"
    [ -f "$dir/kernel.elf" ] && [ -f "$dir/rootfs.img" ] || die "artifact missing kernel.elf/rootfs.img"
    [ -f "$LSA_HOME/default" ] || echo "$name" > "$LSA_HOME/default"   # first install = default
    echo "[lsa] '$name' installed$( [ "$(default_distro)" = "$name" ] && echo ' (default)')"
}

cmd_list() {
    def="$(default_distro)"
    [ -d "$DISTROS" ] || { echo "(no distributions — run: lsa install)"; return; }
    found=0
    for d in "$DISTROS"/*/; do
        [ -d "$d" ] || continue; found=1
        n="$(basename "$d")"
        v="$([ -f "$d/distro.conf" ] && . "$d/distro.conf" 2>/dev/null; echo "${version:-?}")"
        printf '%s %-16s %s\n' "$( [ "$n" = "$def" ] && echo '*' || echo ' ' )" "$n" "$v"
    done
    [ "$found" = 1 ] || echo "(no distributions — run: lsa install)"
}

cmd_set_default() { require_distro "$1"; echo "$1" > "$LSA_HOME/default"; echo "[lsa] default = $1"; }
cmd_unregister()  { require_distro "$1"; rm -rf "$(distro_dir "$1")"; echo "[lsa] removed $1"; }

cmd_version() {
    echo "lsa (Linux Subsystem for Aegis) $LSA_VERSION"
    [ -x "$FC" ] && echo "  vmm:     $("$FC" --version 2>/dev/null | head -1)"
    echo "  default: $(default_distro)"
}

# No persistent VM: each `lsa` boots a fresh micro-VM (~0.3s). `stop` just
# terminates any VM still running (a hung command, or a shell you disconnected).
cmd_stop() {
    if pkill -f "$FC" 2>/dev/null; then echo "[lsa] stopped running micro-VM(s)"
    else echo "[lsa] no micro-VM running"; fi
}

# File interop (WSL's \\wsl$\ equivalent). Firecracker has no 9p/virtiofs, but
# the rootfs is a plain ext2 image that persists across boots, so debugfs moves
# files in/out while the VM is stopped. One argument carries a <distro>:/path
# prefix (empty distro = default); the parent dir of the destination must exist.
cp_guard() { if pgrep -f "$(distro_dir "$1")/rootfs.img" >/dev/null 2>&1; then die "'$1' is running — 'lsa stop' first"; fi; }

cmd_cp() {
    [ $# -eq 2 ] || die "usage: lsa cp <src> <dst>  (one side is <distro>:/path)"
    src="$1"; dst="$2"
    case "$src" in
        *:*)  d="${src%%:*}"; p="${src#*:}"; d="${d:-$(default_distro)}"    # copy OUT
              require_distro "$d"; cp_guard "$d"
              debugfs -R "dump $p $dst" "$(distro_dir "$d")/rootfs.img" 2>/dev/null \
                  && [ -f "$dst" ] || die "copy-out failed: $src" ;;
        *)    case "$dst" in *:*) ;; *) die "one path must be <distro>:/path" ;; esac
              d="${dst%%:*}"; p="${dst#*:}"; d="${d:-$(default_distro)}"    # copy IN
              require_distro "$d"; cp_guard "$d"
              [ -f "$src" ] || die "no such file: $src"
              printf 'rm %s\nwrite %s %s\n' "$p" "$src" "$p" \
                  | debugfs -w -f /dev/stdin "$(distro_dir "$d")/rootfs.img" >/dev/null 2>&1 || die "copy-in failed" ;;
    esac
    echo "[lsa] copied"
}

# shquote — single-quote each argument so word boundaries survive being joined
# into one shell command string for the guest. Without this, `lsa sh -c "echo x
# > f"` flattens to `sh -c echo x > f` and the guest runs `sh -c echo` (no args).
shquote() {
    _out=""
    for _a in "$@"; do
        _e=$(printf '%s' "$_a" | sed "s/'/'\\\\''/g")   # escape ' as '\''
        _out="$_out '$_e'"
    done
    printf '%s' "${_out# }"
}

# Boot a distribution. With no CMD -> interactive shell. With CMD -> run it and
# exit (the guest's lsa init reads lsa.exec= from the kernel cmdline).
cmd_boot() {
    distro="$1"; shift
    require_distro "$distro"
    [ -x "$FC" ] || die "firecracker not found at $FC — run setup.sh"
    [ -r /dev/kvm ] && [ -w /dev/kvm ] || die "/dev/kvm not accessible (add yourself to the 'kvm' group)"
    dir="$(distro_dir "$distro")"

    version=""; mem_mib=512; vcpus=1; boot_args="boot=text"; net=1
    [ -f "$dir/distro.conf" ] && . "$dir/distro.conf"
    [ "${LSA_NET:-1}" = 0 ] && net=0
    # Networking rides the rootless slirp4netns uplink; degrade quietly if the
    # helper isn't installed (older setup, or the user removed it).
    { [ "$net" = 1 ] && [ -x "$SLIRP" ] && [ -x "$HERE/lsa-netns-run" ]; } || net=0

    run=0
    if [ $# -gt 0 ]; then
        # command mode: base64 the command onto the cmdline for the guest to run.
        # One arg = a shell command string as-is (so `lsa 'ls | wc'` pipes work);
        # multiple args = a command + argv, shell-quoted so boundaries survive
        # (so `lsa sh -c "echo x > f"` and `lsa echo a b` are passed intact).
        run=1
        if [ $# -eq 1 ]; then cmdstr="$1"; else cmdstr="$(shquote "$@")"; fi
        enc="$(printf '%s' "$cmdstr" | base64 | tr -d '\n')"
        boot_args="$boot_args lsa.exec=$enc"
    fi

    # With networking on, the guest sits on slirp's 10.0.2.0/24 (gateway .2,
    # DNS .3) and Firecracker gets a tap the netns helper bridges to the uplink.
    netcfg=""
    if [ "$net" = 1 ]; then
        boot_args="$boot_args ip=10.0.2.15/24,10.0.2.2"
        netcfg='"network-interfaces": [ { "iface_id": "net0", "host_dev_name": "fc0", "guest_mac": "02:00:00:00:00:15" } ],'
    fi

    cfg="$(mktemp)"; trap 'rm -f "$cfg"' EXIT
    cat > "$cfg" <<JSON
{
  "boot-source": { "kernel_image_path": "$dir/kernel.elf", "boot_args": "$boot_args" },
  "drives": [ { "drive_id": "rootfs", "path_on_host": "$dir/rootfs.img",
                "is_root_device": true, "is_read_only": false } ],
  $netcfg
  "machine-config": { "vcpu_count": $vcpus, "mem_size_mib": $mem_mib }
}
JSON

    # The VMM is launched directly, or (net on) inside the rootless netns helper.
    if [ "$net" = 1 ]; then set -- "$HERE/lsa-netns-run" "$FC" "$SLIRP" "$cfg"
    else                    set -- "$FC" --no-api --config-file "$cfg"; fi

    if [ "$run" = 0 ]; then
        exec "$@"                                          # interactive shell
    fi

    # run mode: print only the command's output (between the guest markers) and
    # propagate its exit code. The guest reboots after the command, so the VM
    # stops on its own — keep draining after __LSA_END__ (do NOT close the pipe
    # early, or the guest gets SIGPIPE mid-reboot and never exits). A timeout
    # guards against a command that never returns.
    rcf="$(mktemp)"
    timeout "${LSA_RUN_TIMEOUT:-120}" "$@" 2>/dev/null | awk -v rcf="$rcf" '
        /__LSA_END__/    { print $2 > rcf; close(rcf); done=1; next }
        done             { next }
        started          { print }
        /__LSA_BEGIN__/  { started=1 }'
    rc="$(cat "$rcf" 2>/dev/null)"; rm -f "$rcf" "$cfg"
    exit "${rc:-1}"
}

# ── argument dispatch (WSL-like) ─────────────────────────────────────────────
DISTRO="$(default_distro)"
case "${1:-}" in
    ""|shell)        [ "${1:-}" = shell ] && shift; cmd_boot "$DISTRO" ;;
    install)         shift; cmd_install "$@" ;;
    list|-l|--list)  cmd_list ;;
    set-default|-s|--set-default) shift; [ $# -ge 1 ] || usage 1; cmd_set_default "$1" ;;
    unregister)      shift; [ $# -ge 1 ] || usage 1; cmd_unregister "$1" ;;
    cp)              shift; cmd_cp "$@" ;;
    version|--version) cmd_version ;;
    stop|--stop|--shutdown) cmd_stop ;;
    help|-h|--help)  usage 0 ;;
    -d|--distro)     shift; [ $# -ge 1 ] || usage 1; DISTRO="$1"; shift; cmd_boot "$DISTRO" "$@" ;;
    -*)              die "unknown option: $1  (lsa help)" ;;
    *)               cmd_boot "$DISTRO" "$@" ;;    # `lsa <cmd> ...`
esac
